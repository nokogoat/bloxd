{% extends 'base.html.twig' %}

{% block title %}Modifier mon avis{% endblock %}

{% block body %}
    <h1>Modifier mon avis sur {{ avis.jeu.titre }}</h1>

    <div class="col-md-6">
        {{ form_start(form) }}
            {{ form_row(form.note) }}
            {{ form_row(form.commentaire) }}
            <button class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('app_jeu_show', {id: avis.jeu.id}) }}" class="btn btn-link">Annuler</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
