{% extends 'base.html.twig' %}

{% block title %}Chercher sur Roblox - Bloxd{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Chercher sur Roblox</h1>
        <a href="{{ path('app_jeu_index') }}">Retour au catalogue</a>
    </div>

    <form method="get" class="inline-form recherche-roblox">
        <input type="search" name="q" value="{{ q }}" placeholder="Nom d'un jeu Roblox" required autofocus>
        <button class="btn" type="submit">Chercher</button>
    </form>
    <p class="muted">Résultats fournis par l'API de recherche de Roblox. Ajouter un jeu l'importe dans le catalogue avec son icône, sa description et ses stats.</p>

    {% if q and resultats is empty %}
        <p class="muted">Rien trouvé pour « {{ q }} », ou l'API Roblox ne répond pas</p>
    {% endif %}

    <div class="grille-jaquettes">
        {% for r in resultats %}
            <div class="carte-jeu resultat-roblox">
                <div class="jaquette {{ r.icone ? 'avec-image' }}" style="--c: #444">
                    {% if r.icone %}<img src="{{ r.icone }}" alt="" loading="lazy">{% else %}<span class="initiales">?</span>{% endif %}
                </div>
                <div class="carte-infos">
                    <strong>{{ r.nom }}</strong>
                    <span class="muted">{{ r.joueurs|number_format(0, ',', ' ') }} en ligne · {{ r.votes|number_format(0, ',', ' ') }} pouces levés</span>
                    {% if dejaLa[r.placeId] is defined %}
                        <a class="btn btn-small btn-secondary" href="{{ path('app_jeu_show', {id: dejaLa[r.placeId].id}) }}">Déjà là, voir la fiche</a>
                    {% elseif app.user %}
                        <form method="post" action="{{ path('app_jeu_roblox_ajouter') }}">
                            <input type="hidden" name="placeId" value="{{ r.placeId }}">
                            <input type="hidden" name="q" value="{{ q }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('ajouter-roblox') }}">
                            <button class="btn btn-small" type="submit">Ajouter au catalogue</button>
                        </form>
                    {% else %}
                        <a class="btn btn-small btn-secondary" href="{{ path('app_login') }}">Connecte-toi pour l'ajouter</a>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
