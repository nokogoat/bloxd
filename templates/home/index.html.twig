{% extends 'base.html.twig' %}

{% block title %}Bloxd{% endblock %}

{% block body %}
    <div class="p-4 mb-4 bg-white rounded border">
        <h1>Bloxd</h1>
        <p class="lead">Un peu comme Letterboxd mais pour les jeux Roblox : tu notes les jeux auxquels tu as joué, tu laisses un avis et tu vois ce que les autres en pensent.</p>
        <p>Il y a {{ nbJeux }} jeux dans le catalogue pour le moment, et on peut en ajouter directement depuis Roblox.</p>
        {% if app.user %}
            <a href="{{ path('app_jeu_index') }}" class="btn btn-primary">Voir les jeux</a>
        {% else %}
            <a href="{{ path('app_register') }}" class="btn btn-primary">Créer un compte</a>
            <a href="{{ path('app_jeu_index') }}" class="btn btn-outline-secondary">Voir les jeux</a>
        {% endif %}
    </div>

    <h2>Les mieux notés</h2>
    <div class="row row-cols-2 row-cols-md-3 g-3 mb-4">
        {% for row in mieuxNotes %}
            <div class="col">
                <div class="card h-100">
                    <a href="{{ path('app_jeu_show', {id: row.jeu.id}) }}">{% include '_jaquette.html.twig' with {jeu: row.jeu} %}</a>
                    <div class="card-body">
                        <h5 class="card-title"><a href="{{ path('app_jeu_show', {id: row.jeu.id}) }}">{{ row.jeu.titre }}</a></h5>
                        {% include '_etoiles.html.twig' with {note: row.moyenne|round} %} {{ row.moyenne }}/5 <span class="text-muted">({{ row.nb }} avis)</span>
                    </div>
                </div>
            </div>
        {% else %}
            <p>Pas encore d'avis.</p>
        {% endfor %}
    </div>

    <h2>Derniers avis</h2>
    <ul class="list-group mb-4">
        {% for avis in derniersAvis %}
            <li class="list-group-item d-flex gap-3">
                <a href="{{ path('app_jeu_show', {id: avis.jeu.id}) }}">
                    {% if avis.jeu.vignetteUrl %}<img src="{{ avis.jeu.vignetteUrl }}" class="mini-vignette" alt="">{% endif %}
                </a>
                <div>
                    <a href="{{ path('app_jeu_show', {id: avis.jeu.id}) }}"><strong>{{ avis.jeu.titre }}</strong></a>
                    {% include '_etoiles.html.twig' with {note: avis.note} %}
                    <small class="text-muted">par <a href="{{ path('app_profil', {pseudo: avis.auteur.pseudo}) }}">{{ avis.auteur.pseudo }}</a> le {{ avis.creeLe|date('d/m/Y') }}</small>
                    {% if avis.commentaire %}<div>{{ avis.commentaire }}</div>{% endif %}
                </div>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
