{% extends 'base.html.twig' %}

{% block title %}Bloxd, le journal de tes jeux Roblox{% endblock %}

{% block bodyclass %}avec-backdrop{% endblock %}

{% block backdrop %}
    {% if vedette and vedette.vignetteUrl %}
        <div class="backdrop"><img src="{{ vedette.vignetteUrl }}" alt=""></div>
    {% endif %}
{% endblock %}

{% block body %}
    <section class="hero">
        <h1>Garde la trace des jeux Roblox auxquels tu as joué.</h1>
        <p>Note-les sur cinq. Dis ce que tu en as pensé. Vois ce que les autres en disent.</p>
        {% if app.user %}
            <a class="btn btn-primary grand" href="{{ path('app_jeu_index') }}">Trouver un jeu à noter</a>
        {% else %}
            <a class="btn btn-primary grand" href="{{ path('app_register') }}">Créer un compte, c'est gratuit</a>
        {% endif %}
        <div class="compteurs">
            <div><strong>{{ nbJeux }}</strong><span>jeux</span></div>
            <div><strong>{{ nbAvis }}</strong><span>avis</span></div>
            <div><strong>∞</strong><span>via Roblox</span></div>
        </div>
    </section>

    <div class="caps"><span>Les mieux notés</span><a href="{{ path('app_jeu_index') }}">Tout le catalogue</a></div>
    {% if mieuxNotes is empty %}
        <p class="faible">Pas encore d'avis</p>
    {% else %}
        <div class="affiches six">
            {% for row in mieuxNotes %}
                <div>
                    {% include '_affiche.html.twig' with {jeu: row.jeu} %}
                    <div class="sous-affiche">
                        {% include '_etoiles.html.twig' with {note: row.moyenne|round} %}
                        <span class="meta">{{ row.moyenne|number_format(1, ',') }} · {{ row.nb }} avis</span>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="caps"><span>Derniers avis</span></div>
    <div class="avis-liste">
        {% for avis in derniersAvis %}
            <article class="avis avec-affiche">
                {% include '_avatar.html.twig' with {user: avis.auteur} %}
                <div>
                    <div class="avis-tete">
                        <a class="quoi" href="{{ path('app_jeu_show', {id: avis.jeu.id}) }}">{{ avis.jeu.titre }}</a>
                        {% include '_etoiles.html.twig' with {note: avis.note} %}
                        <span class="meta">par <a href="{{ path('app_profil', {pseudo: avis.auteur.pseudo}) }}">{{ avis.auteur.pseudo }}</a>, {{ avis.creeLe|date('d/m/Y') }}</span>
                    </div>
                    {% if avis.commentaire %}<p class="avis-texte">{{ avis.commentaire }}</p>{% endif %}
                </div>
                {% include '_affiche.html.twig' with {jeu: avis.jeu} %}
            </article>
        {% else %}
            <p class="faible">Aucun avis pour le moment</p>
        {% endfor %}
    </div>
{% endblock %}
