{% extends 'base.html.twig' %}

{% block title %}{{ profil.pseudo }}{% endblock %}

{% block body %}
    <h1>Avis de {{ profil.pseudo }}</h1>
    <p class="text-muted">{{ profil.avis|length }} avis{% if moyenne %}, note moyenne {{ moyenne }}/5{% endif %}</p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th></th>
                <th>Jeu</th>
                <th>Note</th>
                <th>Commentaire</th>
                <th>Date</th>
                {% if app.user == profil %}<th></th>{% endif %}
            </tr>
        </thead>
        <tbody>
            {% for avis in profil.avis %}
                <tr>
                    <td>{% if avis.jeu.vignetteUrl %}<img src="{{ avis.jeu.vignetteUrl }}" class="mini-vignette" alt="">{% endif %}</td>
                    <td><a href="{{ path('app_jeu_show', {id: avis.jeu.id}) }}">{{ avis.jeu.titre }}</a></td>
                    <td>{% include '_etoiles.html.twig' with {note: avis.note} %}</td>
                    <td>{{ avis.commentaire }}</td>
                    <td>{{ avis.creeLe|date('d/m/Y') }}</td>
                    {% if app.user == profil %}<td><a href="{{ path('app_avis_edit', {id: avis.id}) }}">modifier</a></td>{% endif %}
                </tr>
            {% else %}
                <tr><td colspan="6">Aucun avis pour l'instant.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
