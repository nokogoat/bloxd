{% extends 'base.html.twig' %}

{% block title %}Admin - Bloxd{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Administration</h1>
        <nav class="admin-nav">
            <a href="{{ path('admin_jeu_index') }}">Jeux</a>
            <a href="{{ path('admin_genre_index') }}">Genres</a>
            <a href="{{ path('admin_user_index') }}">Utilisateurs</a>
        </nav>
    </div>

    <div class="stats">
        <div class="stat"><strong>{{ nbUsers }}</strong><span>utilisateurs</span></div>
        <div class="stat"><strong>{{ nbJeux }}</strong><span>jeux</span></div>
        <div class="stat"><strong>{{ nbGenres }}</strong><span>genres</span></div>
        <div class="stat"><strong>{{ nbAvis }}</strong><span>avis</span></div>
    </div>

    <div class="cols">
        <section class="card">
            <h2>Répartition des notes</h2>
            <p class="muted">Chargée depuis <code>{{ path('admin_api_stats') }}</code></p>
            <div id="repartition" class="barres"></div>
        </section>

        <section class="card">
            <h2>Top 10 des jeux</h2>
            <p class="muted">Chargé depuis <code>{{ path('admin_api_top_jeux') }}</code></p>
            <table id="table-top">
                <thead><tr><th>Jeu</th><th>Genre</th><th>Moyenne</th><th>Avis</th></tr></thead>
                <tbody><tr><td colspan="4" class="muted">Chargement</td></tr></tbody>
            </table>
        </section>
    </div>

    <section class="card">
        <h2>Derniers avis (modération)</h2>
        <p class="muted">Chargés depuis <code>{{ path('admin_api_avis') }}</code>, suppression en <code>DELETE /admin/api/avis/{id}</code></p>
        <table id="table-avis">
            <thead><tr><th>Date</th><th>Jeu</th><th>Auteur</th><th>Note</th><th>Commentaire</th><th></th></tr></thead>
            <tbody><tr><td colspan="6" class="muted">Chargement</td></tr></tbody>
        </table>
    </section>

    <script>
        fetch('{{ path('admin_api_stats') }}').then(r => r.json()).then(d => {
            const max = Math.max(1, ...Object.values(d.repartitionNotes));
            const div = document.getElementById('repartition');
            for (let note = 5; note >= 1; note--) {
                const nb = d.repartitionNotes[note];
                const briques = Array.from({length: 5}, (_, i) => `<i class="${i < note ? 'plein' : ''}"></i>`).join('');
                div.insertAdjacentHTML('beforeend',
                    `<div class="barre-ligne ${nb === max ? 'max' : ''}"><span class="briques">${briques}</span><div class="barre"><div style="width:${100 * nb / max}%"></div></div><span class="nb">${nb}</span></div>`);
            }
        });

        fetch('{{ path('admin_api_top_jeux') }}').then(r => r.json()).then(rows => {
            const tbody = document.querySelector('#table-top tbody');
            tbody.innerHTML = rows.length ? '' : '<tr><td colspan="4" class="muted">Aucun avis</td></tr>';
            for (const r of rows) {
                tbody.insertAdjacentHTML('beforeend', `<tr><td><a href="/jeux/${r.id}">${r.titre}</a></td><td>${r.genre}</td><td>${r.moyenne}</td><td>${r.nbAvis}</td></tr>`);
            }
        });

        const tbodyAvis = document.querySelector('#table-avis tbody');
        async function chargerAvis() {
            const rows = await (await fetch('{{ path('admin_api_avis') }}')).json();
            tbodyAvis.innerHTML = rows.length ? '' : '<tr><td colspan="6" class="muted">Aucun avis</td></tr>';
            for (const r of rows) {
                tbodyAvis.insertAdjacentHTML('beforeend', `
                    <tr>
                        <td>${r.creeLe}</td>
                        <td><a href="/jeux/${r.jeuId}">${r.jeu}</a></td>
                        <td>${r.auteur}</td>
                        <td><span class="briques">${Array.from({length: 5}, (_, i) => `<i class="${i < r.note ? 'plein' : ''}"></i>`).join('')}</span></td>
                        <td>${r.commentaire ? r.commentaire.replace(/</g, '&lt;') : '<span class="muted">-</span>'}</td>
                        <td><button class="btn btn-small btn-danger" data-id="${r.id}">Supprimer</button></td>
                    </tr>`);
            }
        }
        tbodyAvis.addEventListener('click', async (e) => {
            const btn = e.target.closest('button[data-id]');
            if (!btn || !confirm('Supprimer cet avis ?')) return;
            await fetch(`/admin/api/avis/${btn.dataset.id}`, { method: 'DELETE' });
            chargerAvis();
        });
        chargerAvis();
    </script>
{% endblock %}
