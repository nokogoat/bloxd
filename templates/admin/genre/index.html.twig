{% extends 'base.html.twig' %}

{% block title %}Genres (admin){% endblock %}

{% block body %}
    <h1>Genres</h1>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Jeux</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for genre in genres %}
            <tr>
                <td>{{ genre.id }}</td>
                <td>{{ genre.nom }}</td>
                <td>{{ genre.jeux|length }}</td>
                <td>
                    <a href="{{ path('admin_genre_edit', {'id': genre.id}) }}">edit</a>
                    {{ include('admin/genre/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('admin_genre_new') }}" class="btn btn-primary">Create new</a>
    <a href="{{ path('admin_index') }}" class="btn btn-link">Retour</a>
{% endblock %}
