{% extends 'base.html.twig' %}

{% block title %}Admin - Genres{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Genres ({{ genres|length }})</h1>
        <div>
            <a href="{{ path('admin_index') }}">Retour admin</a>
            <a class="btn" href="{{ path('admin_genre_new') }}">Ajouter</a>
        </div>
    </div>

    <section class="card">
        <table>
            <thead>
                <tr>
                    <th>Nom</th><th>Jeux</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for genre in genres %}
                <tr>
                    <td>{{ genre.nom }}</td><td>{{ genre.jeux|length }}</td>
                    <td class="actions">
                        <a href="{{ path('admin_genre_edit', {'id': genre.id}) }}">modifier</a>
                        {{ include('admin/genre/_delete_form.html.twig') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">Aucun enregistrement</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}
