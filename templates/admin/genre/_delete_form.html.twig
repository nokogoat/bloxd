<form method="post" action="{{ path('admin_genre_delete', {'id': genre.id}) }}" onsubmit="return confirm('Supprimer ? Les jeux de ce genre doivent être supprimés ou déplacés avant.');" class="inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ genre.id) }}">
    <button class="btn-link btn-danger-link">supprimer</button>
</form>
