{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
    <h1>Utilisateurs</h1>
    <p class="text-muted small">liste chargée depuis <code>{{ path('admin_api_users') }}</code>, le bouton fait un POST sur <code>/admin/api/utilisateurs/{id}/admin</code></p>

    <table class="table table-striped" id="table-users">
        <thead><tr><th>Pseudo</th><th>Email</th><th>Avis</th><th>Rôle</th><th></th></tr></thead>
        <tbody><tr><td colspan="5">Chargement...</td></tr></tbody>
    </table>

    <a href="{{ path('admin_index') }}" class="btn btn-link">Retour</a>

    <script>
        const tbody = document.querySelector('#table-users tbody');
        function charger() {
            fetch('{{ path('admin_api_users') }}').then(r => r.json()).then(users => {
                tbody.innerHTML = '';
                for (const u of users) {
                    tbody.innerHTML += `<tr>
                        <td><a href="/profil/${u.pseudo}">${u.pseudo}</a></td>
                        <td>${u.email}</td>
                        <td>${u.nbAvis}</td>
                        <td>${u.admin ? '<span class="badge text-bg-warning">admin</span>' : 'joueur'}</td>
                        <td><button class="btn btn-sm btn-outline-secondary" data-id="${u.id}">${u.admin ? 'Retirer admin' : 'Rendre admin'}</button></td>
                    </tr>`;
                }
            });
        }
        tbody.addEventListener('click', async e => {
            const btn = e.target.closest('button[data-id]');
            if (!btn) return;
            const r = await fetch('/admin/api/utilisateurs/' + btn.dataset.id + '/admin', { method: 'POST' });
            if (!r.ok) alert((await r.json()).error);
            charger();
        });
        charger();
    </script>
{% endblock %}
