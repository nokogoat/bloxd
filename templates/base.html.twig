<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Bloxd{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2220%22 fill=%22%2314181c%22/><rect x=%2216%22 y=%2248%22 width=%2228%22 height=%2228%22 rx=%224%22 fill=%22%23ff8000%22/><rect x=%2250%22 y=%2248%22 width=%2228%22 height=%2228%22 rx=%224%22 fill=%22%2300e054%22/><rect x=%2284%22 y=%2248%22 width=%2228%22 height=%2228%22 rx=%224%22 fill=%22%2340bcf4%22/></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600;700&family=Newsreader:wght@500;700&display=swap" rel="stylesheet">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="{% block bodyclass %}{% endblock %}">
        {% block backdrop %}{% endblock %}

        <nav class="nav">
            <a class="logo" href="{{ path('app_home') }}"><span class="briques"><i></i><i></i><i></i></span>Bloxd</a>
            <div class="liens">
                <a href="{{ path('app_jeu_index') }}">Jeux</a>
                {% if app.user %}
                    <a href="{{ path('app_profil', {pseudo: app.user.pseudo}) }}">Mes avis</a>
                    {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin_index') }}">Admin</a>{% endif %}
                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary">Créer un compte</a>
                {% endif %}
                <form method="get" action="{{ path('app_jeu_index') }}">
                    <input type="search" name="q" class="recherche" placeholder="Chercher un jeu" value="{{ app.request.query.get('q') }}">
                </form>
            </div>
        </nav>

        <main class="page">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="footer">Bloxd. Projet R5.06. Les images et les stats des jeux viennent de Roblox.</footer>
    </body>
</html>
