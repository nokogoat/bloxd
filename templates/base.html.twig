<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Bloxd{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2224%22 fill=%22%2314181c%22/><circle cx=%2240%22 cy=%2264%22 r=%2216%22 fill=%22%2300e054%22/><circle cx=%2288%22 cy=%2264%22 r=%2216%22 fill=%22%23ff8000%22/></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="topbar">
            <a class="logo" href="{{ path('app_home') }}"><span class="dot vert"></span><span class="dot orange"></span> Bloxd</a>
            <nav>
                <a href="{{ path('app_jeu_index') }}">Jeux</a>
                {% if app.user %}
                    <a href="{{ path('app_profil', {pseudo: app.user.pseudo}) }}">Mon journal</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_index') }}">Admin</a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}" class="muted">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-small">Inscription</a>
                {% endif %}
            </nav>
        </header>

        <main class="container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="footer">Bloxd — projet R5.06, un Letterboxd pour les jeux Roblox.</footer>
    </body>
</html>
