<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Bloxd{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎮</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand navbar-light bg-light px-3 mb-3">
            <a class="navbar-brand" href="{{ path('app_home') }}">Bloxd</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_jeu_index') }}">Jeux</a></li>
                {% if app.user %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_profil', {pseudo: app.user.pseudo}) }}">Mes avis</a></li>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('admin_index') }}">Admin</a></li>
                {% endif %}
            </ul>
            <div>
                {# app.user vaut null tant que personne n'est connecté #}
                {% if app.user %}
                    <span class="me-2">Connecté en tant que {{ app.user.pseudo }}</span>
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm">Logout</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-sm">Login</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm">Register</a>
                {% endif %}
            </div>
        </nav>

        <div class="container">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}

            {% block body %}{% endblock %}
        </div>
    </body>
</html>
